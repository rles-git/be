
PORT=10000

# Start with mock data
CHARGER_DATA_MODE=mock

# Used when hybrid mode is enabled
LIVE_CHARGER_IDS=Q001,Q004

# Set a long, random secret before enabling live ingestion
LIVE_INGEST_TOKEN=replace-with-a-long-random-secret

# Mark live readings stale after 15 seconds
LIVE_STALE_AFTER_MS=15000
